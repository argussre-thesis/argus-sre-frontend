# Copy to .env.local (gitignored) and fill in.

# Backend origin, without /api/v1.
VITE_API_URL=http://localhost:5000

# Clerk Dashboard -> API keys -> Publishable key.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Host of our hosted Grafana MCP server. Production: grafana-mcp.argussre.com
VITE_GRAFANA_MCP_HOST=staging.grafana-mcp.argussre.com

# Gateway the runner dials out to; shown in the runner install commands. Production: https://gateway.argussre.com
VITE_GATEWAY_URL=https://staging.gateway.argussre.com
